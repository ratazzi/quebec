// Per-class job duration and new-RSS histograms from Quebec's USDT probes.
// No special privileges beyond what bpftrace itself needs; works in any mode.
//
//   sudo bpftrace -p <worker pid> job_latency.bt
//   sudo bpftrace job_latency.bt /path/to/site-packages/quebec/quebec.abi3.so
//
// quebec:job_end args: jid(ptr,len), class(ptr,len), ok, duration_ns,
//                      minflt (-1 if unavailable), new_rss_bytes (-1 if unavailable)

usdt:$1:quebec:job_end
{
  $class = str(arg2, arg3);
  @duration_ms[$class] = hist(arg5 / 1000000);
  if ((int64)arg7 >= 0) {
    @new_rss_mb[$class] = hist(arg7 / 1048576);
  }
  if (arg4 == 0) {
    @failed[$class] = count();
  }
}
